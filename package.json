{
  "name": "pipulse",
  "private": true,
  "version": "0.0.0",
  "description": "A modern rewrite of RPi-Monitor.",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace=packages/storage && npm run build --workspace=packages/collector && npm run build --workspace=packages/alerts && npm run build --workspace=packages/notify && npm run build --workspace=packages/tls && npm run build --workspace=packages/api && npm run build --workspace=packages/web",
    "test": "npm run build && NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:coverage": "npm run build && NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run --coverage",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "dev": "npm run dev --workspace packages/api",
    "test:e2e": "npm run build && npm --prefix e2e test",
    "mutate": "node scripts/mutate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^22.20.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
