#!/bin/sh
# pipulse — PiPulse's command-line helper (installed as /usr/bin/pipulse).
set -eu
node=/opt/pipulse/node/bin/node
# The Docker image has no bundled Node of its own: use the image's.
[ -x "$node" ] || node=/usr/local/bin/node
app=/opt/pipulse/app
env=/etc/pipulse/pipulse.env
# The service's settings (and NODE_EXTRA_CA_CERTS), read as data the way systemd reads them: one
# NAME=value per line, one pair of surrounding quotes dropped, the last line for a name wins.
# Never sourced as shell, so a value with $, backticks or quotes cannot run anything.
load_env() {
  [ -r "$env" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in '' | '#'* | ' '* | '	'*) continue ;; esac
    name=${line%%=*}
    [ "$name" != "$line" ] || continue
    case $name in '' | [0-9]* | *[!A-Za-z0-9_]*) continue ;; esac
    value=${line#*=}
    case $value in
      \"*\") value=${value#\"}; value=${value%\"} ;;
      \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    export "$name=$value"
  done < "$env"
}
run() {
  load_env
  exec "$node" --disable-warning=ExperimentalWarning "$@"
}
case ${1:-} in
  version)
    ver=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$app/version.json" 2>/dev/null || true)
    echo "PiPulse ${ver:-dev}, Node $("$node" --version)" ;;
  notify-test)
    shift
    if [ "$(id -u)" -eq 0 ]; then exec setpriv --reuid=pipulse --regid=pipulse --init-groups "$0" notify-test "$@"; fi
    run "$app/packages/api/dist/notify-test.js" "$@" ;;
  hash-password)
    run "$app/packages/api/dist/hash-password.js" ;;
  tls)
    shift
    # Mostly run as root: the CLI reads pipulse.env as data itself; never source it here.
    exec "$node" --disable-warning=ExperimentalWarning "$app/packages/tls/dist/cli.js" "$@" ;;
  *)
    echo 'usage: pipulse version | notify-test [webhook-id] | hash-password | tls <command> (pipulse tls help)' >&2; exit 2 ;;
esac
