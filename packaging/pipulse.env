# PiPulse settings — read by systemd (EnvironmentFile) and Docker (env_file).
# Uncomment and change what you need, then: sudo systemctl restart pipulse
# Files mentioned here belong in /etc/pipulse/ (root:pipulse, mode 640).

# Network
#PIPULSE_HOST=0.0.0.0
#PIPULSE_PORT=8889
#PIPULSE_ALLOWED_ORIGINS=

# HTTPS (see README "HTTPS"). A fresh install serves HTTPS from a certificate made for this Pi;
# an upgrade stays on plain HTTP until `sudo pipulse tls enable`.
# PIPULSE_TLS=off forces plain HTTP whatever else is set (and no CA is made); =on forces HTTPS.
# Your own certificate: both files, together.
#PIPULSE_TLS=on
#PIPULSE_TLS_CERT=/etc/pipulse/tls-cert.pem
#PIPULSE_TLS_KEY=/etc/pipulse/tls-key.pem
# The CA that issued it, if it's a private one (used to check the chain and by the installer's health check)
#PIPULSE_TLS_CA=/etc/pipulse/tls-ca.pem
# Names the certificate must cover (a missing one shows as a warning)
#PIPULSE_TLS_NAMES=io.lan
# Generated certificate (sudo pipulse tls init): IP ranges the CA may cover, besides names.
# Only a subnet you accept here or with --subnet is ever covered (see README "HTTPS").
#PIPULSE_TLS_SUBNETS=192.168.1.0/24
# The name PiPulse shows and puts in its certificate. Native installs use the machine's own name.
# Docker mounts the host's /etc/hostname for it; on a host without that file (Docker Desktop,
# Colima on a Mac) delete that mount from compose.yaml and set the name here, otherwise it
# falls back to the container's own name.
#PIPULSE_HOSTNAME=io
# PIPULSE_TLS_DIR, PIPULSE_TLS_CA_DIR, PIPULSE_TLS_TIMESYNC_DIR and PIPULSE_RUNTIME_DIR are set by
# the Docker image or the systemd unit and rarely need changing.
# PIPULSE_TLS_DIR: leave it unset on a Pi install. Generated certificates live only in
# /etc/pipulse/tls, the one folder the renewal service may write; pipulse tls refuses any other.
# Refuse to start with an expired or not-yet-valid certificate (default: start and warn)
#PIPULSE_TLS_REQUIRE_VALID_CERT=false
# Opt-in HSTS; it applies to every port on this host name in the browser, so leave it off
# if other web interfaces run here over plain HTTP (Pi-hole, RPi-Monitor)
#PIPULSE_TLS_HSTS=1d
# chrony/ntpd instead of systemd-timesyncd: trust the clock for certificate decisions
#PIPULSE_TLS_CLOCK=trust

# History kept per resolution (s, min, h, d, w, y or forever)
#PIPULSE_RETENTION_RAW=2d
#PIPULSE_RETENTION_1M=14d
#PIPULSE_RETENTION_1H=1y
#PIPULSE_RETENTION_1D=forever

# Sign-in: make a hash with `pipulse hash-password | sudo tee /etc/pipulse/admin.hash >/dev/null`
# (then `sudo chown root:pipulse /etc/pipulse/admin.hash && sudo chmod 640 /etc/pipulse/admin.hash`)
#PIPULSE_ADMIN_PASSWORD_HASH_FILE=/etc/pipulse/admin.hash
#PIPULSE_PROTECT_READS=false

# Alert rules and notifications
#PIPULSE_ALERTS_FILE=/etc/pipulse/rules.json
#PIPULSE_NOTIFY_FILE=/etc/pipulse/notify.json

# A private certificate authority for HTTPS webhook receivers (e.g. a homelab CA)
#NODE_EXTRA_CA_CERTS=/etc/pipulse/homelab-ca.pem
