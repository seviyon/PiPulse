{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "vulnerabilityAlerts": {
    "labels": ["release:patch", "security"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor", "digest", "pin", "pinDigest"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Majors wait for approval on the Dependency Dashboard instead of opening PRs.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "PiPulse's own image in compose.yaml follows :latest; the release stamps the shipped file with its tag, so a digest pin only goes stale.",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["ghcr.io/seviyon/pipulse"],
      "enabled": false
    },
    {
      "description": "The workflows and their containers run the Node that ships on the Pi (armhf stays on 22).",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["node"],
      "allowedVersions": "<23"
    },
    {
      "description": "Types for the oldest supported Node (engines >=22.13), so nothing newer than Node 22 typechecks.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<23"
    },
    {
      "matchFileNames": ["packaging/node-versions.json"],
      "matchDepNames": ["node-armhf"],
      "allowedVersions": "<23"
    },
    {
      "matchFileNames": ["packaging/node-versions.json"],
      "matchDepNames": ["node-arm64", "node-amd64"],
      "allowedVersions": "/^(24|26|28)\\./",
      "groupName": "bundled Node (64-bit)"
    },
    {
      "description": "Only updates that change what ships make a release: runtime dependencies (bundled into the app or the dashboard).",
      "matchDepTypes": ["dependencies"],
      "addLabels": ["release:patch"]
    },
    {
      "description": "The Node bundled into every native install.",
      "matchFileNames": ["packaging/node-versions.json"],
      "addLabels": ["release:patch"]
    },
    {
      "description": "The Docker image's base (Node and Debian in the image).",
      "matchManagers": ["dockerfile"],
      "addLabels": ["release:patch"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^packaging/node-versions\\.json$/"],
      "matchStrings": ["\"(?<depName>armhf|arm64|amd64)\": \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "node-{{depName}}",
      "packageNameTemplate": "node",
      "datasourceTemplate": "node-version"
    }
  ]
}
